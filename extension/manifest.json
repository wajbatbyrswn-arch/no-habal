{
  "manifest_version": 3,
  "name": "NO HABAL",
  "short_name": "NO HABAL",
  "version": "1.1.0",
  "description": "إخفاء الحسابات التافهة على إنستغرام وفيسبوك وتيك توك وX وريدت بناءً على قائمة جماعية.",
  "default_locale": "ar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://bohiqxxispuwipmfijgn.supabase.co/*"
  ],
  "action": {
    "default_title": "NO HABAL",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/core.js", "content/instagram.js"],
      "css": ["content/core.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content/core.js", "content/facebook.js"],
      "css": ["content/core.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["content/core.js", "content/x.js"],
      "css": ["content/core.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["content/core.js", "content/tiktok.js"],
      "css": ["content/core.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://reddit.com/*",
        "https://old.reddit.com/*",
        "https://np.reddit.com/*"
      ],
      "js": ["content/core.js", "content/reddit.js"],
      "css": ["content/core.css"],
      "run_at": "document_idle"
    }
  ]
}
